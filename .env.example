# ================================================================
# Real-Time Voice AI Agent Configuration
# ================================================================

# --- Required API Keys ---
# Get your Deepgram API Key from: https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Get your Groq API Key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Model & Voice Configuration (Defaults tuned for lowest latency) ---
GROQ_MODEL=llama-3.1-8b-instant
DEEPGRAM_TTS_VOICE=aura-asteria-en

# --- VAD & Barge-in Tuning ---
VAD_CONFIDENCE=0.7
VAD_START_SECS=0.15
VAD_STOP_SECS=0.25

# --- Optional Audio Device Overrides ---
# Leave blank to auto-detect system microphone and speakers
AUDIO_INPUT_DEVICE_INDEX=
AUDIO_OUTPUT_DEVICE_INDEX=
